# :command.function
simci_portainer_stack_get_id_command() {

  # src/portainer_stack_get_id_command.sh
  portainer_server=$(_sim_cicd_normalize_portainer_base "${args[portainer_server]}")
  portainer_url="portainer.$portainer_server"
  stack=${args[stack]}
  env_id=${args[--environment]}
  verbose=${args[--verbose]}

  if [ -n "$verbose" ]; then
      echo "[sim-cicd] === GET PORTAINER STACK ID"
      echo "[sim-cicd] Getting stacks on $portainer_url (endpoint $env_id)."
  fi

  stacks=$(curl -s -G "https://$portainer_url/api/stacks" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" \
      -d "filter={'EndpointID':$env_id}")
  stack_id=$(jq -r --arg s "$stack" '.[] | select(.Name==$s) | .Id' <<<"$stacks")

  if [ -z "$stack_id" ] || [ "$stack_id" = "null" ]; then
      if [ -n "$verbose" ]; then
          echo "[sim-cicd] Stack '$stack' not found."
      fi
      exit 1
  else
      if [ -n "$verbose" ]; then
          echo "[sim-cicd] $stack's ID found: $stack_id"
      else
          echo "$stack_id"
      fi
  fi
}

# :command.function
simci_portainer_stack_get_file_command() {

  # src/portainer_stack_get_file_command.sh
  portainer_server=$(_sim_cicd_normalize_portainer_base "${args[portainer_server]}")
  stack=${args[stack]}
  env_id=${args[--environment]}

  portainer_url="portainer.$portainer_server"

  echo "[sim-cicd] === GET FILE FROM PORTAINER STACK"

  simci_portainer_stack_stop_command "$stack" "$portainer_server" "$env_id" ""

  # Retrieve volume's file using a temporary busybox container
  CONTAINER_ID=$(curl -s -X POST \
    -H "X-API-Key:$PORTAINER_API_TOKEN" \
    -H "Content-Type: application/json" \
    "https://$portainer_url/api/endpoints/$env_id/docker/containers/create" \
    -d "{
      \"Image\": \"busybox\",
      \"Cmd\": [\"cat\", \"/data/jacoco.exec\"],
      \"HostConfig\": {
        \"Binds\": [\"${stack}_jacoco-data:/data\"]
      }
    }" | jq -r .Id)

  echo $CONTAINER_ID

  curl -s -X POST \
    -H "X-API-Key:$PORTAINER_API_TOKEN" \
    "https://$portainer_url/api/endpoints/$env_id/docker/containers/$CONTAINER_ID/start"

  curl -s \
    -H "X-API-Key:$PORTAINER_API_TOKEN" \
    "https://$portainer_url/api/endpoints/$env_id/docker/containers/$CONTAINER_ID/logs?stdout=1" \
    > jacoco.exec

  curl -s -X DELETE \
    -H "X-API-Key:$PORTAINER_API_TOKEN" \
    "https://$portainer_url/api/endpoints/$env_id/docker/containers/$CONTAINER_ID"

  simci_portainer_stack_start_command "$stack" "$portainer_server" "$env_id" ""
}

# :command.function
simci_portainer_stack_get_coverage_command() {

  # src/portainer_stack_get_coverage_command.sh
  # Restart the app container so jacoco writes the report, then download jacoco.xml.
  portainer_server=$(_sim_cicd_normalize_portainer_base "${args[portainer_server]}")
  stack=${args[stack]}
  env_id=${args[--environment]}

  portainer_url="portainer.$portainer_server"
  # Must match Traefik Host in portainer-stack.yml: ${COMPOSE_PROJECT_NAME}.<base>
  instance="$stack.$portainer_server"

  echo "[sim-cicd] === GET COVERAGE FROM PORTAINER STACK"

  CONTAINER_ID=$(_sim_cicd_curl_portainer \
      "https://$portainer_url/api/endpoints/$env_id/docker/containers/json?all=1" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" \
      | jq -r ".[] | select(.Labels[\"com.docker.compose.project\"]==\"$stack\") | .Id" | head -n 1)

  if [ -z "$CONTAINER_ID" ] || [ "$CONTAINER_ID" = "null" ]; then
      echo "[sim-cicd] No container found for stack '$stack' on $portainer_url (endpoint $env_id)" >&2
      exit 1
  fi

  _sim_cicd_curl_portainer -X POST \
      "https://$portainer_url/api/endpoints/$env_id/docker/containers/$CONTAINER_ID/restart" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" \
      -o /dev/null

  if ! _sim_cicd_wait_for_container_health "$portainer_url" "$env_id" "$CONTAINER_ID"; then
      exit 1
  fi

  # App TLS may also be self-signed from CI runners
  _sim_cicd_curl_portainer "https://$instance/content/jacoco/jacoco.xml" -o jacoco.xml
  if [[ ! -s jacoco.xml ]] || ! grep -q '<report\|<?xml' jacoco.xml 2>/dev/null; then
      echo "[sim-cicd] Failed to download jacoco.xml from https://$instance/content/jacoco/jacoco.xml" >&2
      head -c 200 jacoco.xml 2>/dev/null >&2 || true
      echo >&2
      exit 1
  fi
}

# :command.function
simci_simplicite_run_unit_tests_command() {

  # src/simplicite_run_unit_tests_command.sh
  # Calls Simplicité IO unittests on the deployed stack host.
  local response http_code
  portainer_server=$(_sim_cicd_normalize_portainer_base "${args[portainer_server]}")
  stack=${args[stack]}
  # Must match Traefik Host in portainer-stack.yml: ${COMPOSE_PROJECT_NAME}.<base>
  instance="$stack.$portainer_server"
  module=${args[module]}

  echo "[sim-cicd] === RUN UNIT TESTS"
  echo "[sim-cicd] POST https://$instance/io (module=$module)"

  response=$(mktemp)
  http_code=$(_sim_cicd_curl_portainer -u "designer:$IO_PASSWORD" \
      --form "service=unittests" \
      --form "module=$module" \
      "https://$instance/io" \
      -o "$response" \
      -w "%{http_code}" || true)

  cat "$response"
  echo

  if [[ ! "$http_code" =~ ^2 ]]; then
      echo "[sim-cicd] Unit tests HTTP call failed (HTTP ${http_code:-000}) against https://$instance/io" >&2
      echo "[sim-cicd] Check PORTAINER_URL matches the Traefik host base in portainer-stack.yml" >&2
      rm -f "$response"
      exit 1
  fi

  if grep -q "ERROR" "$response"; then
      rm -f "$response"
      exit 1
  fi
  rm -f "$response"
}

# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        simci_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    portainer-stack-deploy)
      action="portainer-stack-deploy"
      shift
      simci_portainer_stack_deploy_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-delete)
      action="portainer-stack-delete"
      shift
      simci_portainer_stack_delete_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-stop)
      action="portainer-stack-stop"
      shift
      simci_portainer_stack_stop_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-start)
      action="portainer-stack-start"
      shift
      simci_portainer_stack_start_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-get-id)
      action="portainer-stack-get-id"
      shift
      simci_portainer_stack_get_id_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-get-file)
      action="portainer-stack-get-file"
      shift
      simci_portainer_stack_get_file_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-get-coverage)
      action="portainer-stack-get-coverage"
      shift
      simci_portainer_stack_get_coverage_parse_requirements "$@"
      shift $#
      ;;

    simplicite-run-unit-tests)
      action="simplicite-run-unit-tests"
      shift
      simci_simplicite_run_unit_tests_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      simci_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

