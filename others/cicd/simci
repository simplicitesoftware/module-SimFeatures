# :command.user_hooks
before_hook() {
  # src/before.sh
  # Ensure required tools are installed (curl, jq)
  _sim_cicd_require_tools() {
    local install_cmd
    for cmd in curl jq; do
      if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "[sim-cicd] Missing required command: $cmd, attempting to install..."

        # Detect package manager and install
        if command -v apt-get >/dev/null 2>&1; then
          install_cmd="apt-get update -qq && apt-get install -y $cmd"
        elif command -v yum >/dev/null 2>&1; then
          install_cmd="yum install -y $cmd"
        elif command -v dnf >/dev/null 2>&1; then
          install_cmd="dnf install -y $cmd"
        elif command -v apk >/dev/null 2>&1; then
          install_cmd="apk add --no-cache $cmd"
        elif command -v brew >/dev/null 2>&1; then
          install_cmd="brew install $cmd"
        else
          echo "[sim-cicd] Could not detect package manager to install $cmd" >&2
          exit 1
        fi

        if eval "$install_cmd"; then
          echo "[sim-cicd] Successfully installed $cmd"
        else
          echo "[sim-cicd] Failed to install $cmd" >&2
          exit 1
        fi
      fi
    done

    return 0
  }

  # ---------------------------------------------------------------------------
  # Shared helpers (image pull / registry auth for Portainer CE)
  # ---------------------------------------------------------------------------

  # Base64 without newlines (Docker X-Registry-Auth header).
  _sim_cicd_b64() {
    echo -n "$1" | base64 | tr -d '\n'
  }

  # Strip CR/LF/surrounding whitespace from CI variables.
  _sim_cicd_trim() {
    local s="$1"
    s="${s//$'\r'/}"
    s="${s//$'\n'/}"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
  }

  # When PORTAINER_INSECURE_SSL=1, skip TLS verify for Portainer (self-signed / private CA).
  # Writes ~/.curlrc so plain `curl` calls elsewhere in this script also skip verify.
  _sim_cicd_init_tls() {
    case "${PORTAINER_INSECURE_SSL:-}" in
      1|true|TRUE|yes|YES)
        if [[ ! -f "$HOME/.curlrc" ]] || ! grep -qxF 'insecure' "$HOME/.curlrc" 2>/dev/null; then
          printf 'insecure\n' >> "$HOME/.curlrc"
        fi
        ;;
    esac
  }

  # curl wrapper for Portainer API: long timeout (image pulls) + optional -k.
  _sim_cicd_curl_portainer() {
    local curl_opts=(--connect-timeout 30 --max-time 900 -sS)
    case "${PORTAINER_INSECURE_SSL:-}" in
      1|true|TRUE|yes|YES) curl_opts+=(-k) ;;
    esac
    curl "${curl_opts[@]}" "$@"
  }

  # Normalize PORTAINER_URL / CLI arg to a bare domain (strip scheme, trailing slash, portainer. prefix).
  _sim_cicd_normalize_portainer_base() {
    local s
    s=$(_sim_cicd_trim "$1")
    s="${s#https://}"
    s="${s#http://}"
    s="${s%/}"
    s="${s#portainer.}"
    printf '%s' "$s"
  }

  _sim_cicd_init_tls

  # Unique `image:` values from a compose file.
  _sim_cicd_compose_images() {
    local compose_file="$1"
    grep -E '^\s+image:' "$compose_file" 2>/dev/null \
      | sed -E 's/^[[:space:]]*image:[[:space:]]*//;s/^["'\'']//;s/["'\'']$//' \
      | sort -u || true
  }

  # Registry host from an image ref (e.g. registry.simplicite.io/platform:7-alpha → registry.simplicite.io).
  # Empty for Docker Hub short names (no private-registry pre-pull).
  _sim_cicd_image_registry() {
    local img="$1"
    local ref="${img%%/*}"

    if [[ "$img" == */* ]] && [[ "$ref" == *.* || "$ref" == *:* ]]; then
      echo "$ref"
    fi
  }

  # List registries visible to the API user. Prefer endpoint-scoped list; fall back to global
  # /api/registries (endpoint list is often [] when the CI user lacks env registry access).
  _sim_cicd_portainer_registries_for_endpoint() {
    local portainer_url="$1"
    local env_id="$2"
    local response=""

    if [[ -n "${_sim_cicd_portainer_registries_cache:-}" && "${_sim_cicd_portainer_registries_cache_env_id:-}" == "$env_id" ]]; then
      echo "$_sim_cicd_portainer_registries_cache"
      return 0
    fi

    response=$(_sim_cicd_curl_portainer "https://$portainer_url/api/endpoints/${env_id}/registries" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" 2>/dev/null || true)
    if jq -e 'type == "array" and length > 0' <<< "$response" >/dev/null 2>&1; then
      _sim_cicd_portainer_registries_cache="$response"
      _sim_cicd_portainer_registries_cache_env_id="$env_id"
      echo "$response"
      return 0
    fi

    response=$(_sim_cicd_curl_portainer "https://$portainer_url/api/registries" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" 2>/dev/null || true)
    if jq -e 'type == "array"' <<< "$response" >/dev/null 2>&1; then
      _sim_cicd_portainer_registries_cache="$response"
      _sim_cicd_portainer_registries_cache_env_id="$env_id"
      echo "$response"
      return 0
    fi

    _sim_cicd_portainer_registries_cache="[]"
    _sim_cicd_portainer_registries_cache_env_id="$env_id"
    echo "[]"
  }

  # Resolve Portainer registry Id for a registry host.
  # Prefer REGISTRY_ID (required in CI when the user cannot list registries).
  # Else match by URL or name (REGISTRY_NAME, or "simplicite" for *.simplicite.io).
  _sim_cicd_registry_id_for_host() {
    local portainer_url="$1"
    local env_id="$2"
    local registry_host="$3"
    local registries registry_id registry_name lookup_name count

    if [[ -n "${REGISTRY_ID:-}" ]]; then
      REGISTRY_ID=$(_sim_cicd_trim "$REGISTRY_ID")
      if [[ ! "$REGISTRY_ID" =~ ^[0-9]+$ ]]; then
        echo "[sim-cicd] REGISTRY_ID must be numeric (got '${REGISTRY_ID}')" >&2
        return 1
      fi
      echo "[sim-cicd] Using Portainer registry ID ${REGISTRY_ID}" >&2
      echo "$REGISTRY_ID"
      return 0
    fi

    lookup_name="${REGISTRY_NAME:-}"
    if [[ -z "$lookup_name" && "$registry_host" == *simplicite.io* ]]; then
      lookup_name="simplicite"
    fi

    registries=$(_sim_cicd_portainer_registries_for_endpoint "$portainer_url" "$env_id")
    count=$(jq -r 'if type == "array" then length else 0 end' <<< "$registries")
    registry_id=$(jq -r --arg registry "$registry_host" --arg registry_name "$lookup_name" '
      def registry_url_host:
        sub("^https?://"; "") | split("/")[0] | ascii_downcase;
      def name_matches($name):
        ($name | ascii_downcase) as $n
        | $n != "" and (
            ($registry | ascii_downcase | contains($n))
            or ($registry_name != "" and $n == ($registry_name | ascii_downcase))
          );
      if type != "array" then empty
      else .[]
        | select(
            ((.URL // "") | registry_url_host) == ($registry | ascii_downcase)
            or name_matches(.Name // "")
          )
        | .Id
      end
    ' <<< "$registries" | head -n 1)

    if [[ -n "$registry_id" && "$registry_id" != "null" ]]; then
      registry_name=$(jq -r --argjson id "$registry_id" '
        if type != "array" then empty
        else .[] | select(.Id == $id) | .Name // empty
        end
      ' <<< "$registries")
      echo "[sim-cicd] Matched Portainer registry '${registry_name:-$registry_id}'" >&2
      echo "$registry_id"
      return 0
    fi

    echo "[sim-cicd] No Portainer registry found for $registry_host ($count visible)" >&2
    echo "[sim-cicd] Set REGISTRY_ID (Portainer → Registries → Id) or grant registry access to the CI user" >&2
    return 1
  }

  # Build X-Registry-Auth value for Docker images/create.
  # Prefer REGISTRY_USERNAME/PASSWORD; else Portainer {"registryId":N} (server injects stored creds).
  _sim_cicd_registry_auth_header() {
    local portainer_url="$1"
    local env_id="$2"
    local registry_host="$3"
    local registry_id

    if [[ -n "${REGISTRY_USERNAME:-}" && -n "${REGISTRY_PASSWORD:-}" ]]; then
      echo "[sim-cicd] Using REGISTRY_USERNAME/PASSWORD for $registry_host" >&2
      _sim_cicd_b64 "$(jq -nc \
        --arg username "$REGISTRY_USERNAME" \
        --arg password "$REGISTRY_PASSWORD" \
        --arg serveraddress "$registry_host" \
        '{username: $username, password: $password, serveraddress: $serveraddress}')"
      return 0
    fi

    registry_id=$(_sim_cicd_registry_id_for_host "$portainer_url" "$env_id" "$registry_host") || return 1
    if [[ -z "$registry_id" || "$registry_id" == "null" ]]; then
      return 1
    fi

    _sim_cicd_b64 "$(jq -nc --argjson id "$registry_id" '{registryId: $id}')"
  }

  # Docker images/create returns NDJSON; HTTP 200 can still end with an error object.
  _sim_cicd_docker_pull_stream_error() {
    local response_file="$1"
    jq -rs '
      map(select(type == "object" and ((.error // .message // "") != "")))
      | if length == 0 then empty
        else .[-1].error // .[-1].message
        end
    ' "$response_file" 2>/dev/null || true
  }

  # Untag/remove local image so the next pull cannot reuse a stale mutable tag.
  _sim_cicd_remove_local_image() {
    local portainer_url="$1"
    local env_id="$2"
    local img="$3"
    local encoded http_code

    encoded=$(jq -nr --arg s "$img" '$s|@uri')
    echo "[sim-cicd] Removing local image $img..."
    http_code=$(_sim_cicd_curl_portainer -X DELETE \
      "https://$portainer_url/api/endpoints/$env_id/docker/images/${encoded}?force=true" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" \
      -o /dev/null \
      -w "%{http_code}" \
      2>/dev/null || true)

    # 200/204 removed, 404 absent — both fine before pull
    [[ "$http_code" =~ ^(200|204|404)$ ]] && return 0
    echo "[sim-cicd] Warning: could not remove local image $img (HTTP ${http_code:-000}); continuing" >&2
    return 0
  }

  # Smoke-test Portainer's Docker API proxy before attempting image pulls.
  _sim_cicd_docker_proxy_preflight() {
    local portainer_url="$1"
    local env_id="$2"
    local response http_code

    response=$(mktemp)
    http_code=$(_sim_cicd_curl_portainer \
      "https://$portainer_url/api/endpoints/$env_id/docker/containers/json?all=true&limit=1" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" \
      -o "$response" \
      -w "%{http_code}" \
      2>/dev/null || true)

    if [[ "$http_code" =~ ^2 ]]; then
      rm -f "$response"
      return 0
    fi

    echo "[sim-cicd] Docker proxy preflight failed (HTTP ${http_code:-000}) on endpoint $env_id" >&2
    if [[ -s "$response" ]]; then
      head -c 500 "$response" >&2
      echo >&2
    fi
    rm -f "$response"
    return 1
  }

  # Pull one private image through Portainer → Docker Engine (uses registry auth above).
  _sim_cicd_pull_image_via_portainer() {
    local portainer_url="$1"
    local env_id="$2"
    local img="$3"
    local registry_host registry_auth from_image tag
    local response http_code error_msg curl_err

    registry_host=$(_sim_cicd_image_registry "$img")
    if [[ -z "$registry_host" ]]; then
      echo "[sim-cicd] Skipping pre-pull for public image $img"
      return 0
    fi

    registry_auth=$(_sim_cicd_registry_auth_header "$portainer_url" "$env_id" "$registry_host") || return 1

    from_image="${img%:*}"
    tag="${img##*:}"
    if [[ "$from_image" == "$tag" ]]; then
      tag="latest"
    fi

    _sim_cicd_remove_local_image "$portainer_url" "$env_id" "$img"

    echo "[sim-cicd] Pulling image $img..."
    response=$(mktemp)
    curl_err=$(mktemp)
    # -G + -X POST: Docker API expects fromImage/tag as query params on POST /images/create
    http_code=$(_sim_cicd_curl_portainer -G -X POST \
      "https://$portainer_url/api/endpoints/$env_id/docker/images/create" \
      --data-urlencode "fromImage=$from_image" \
      --data-urlencode "tag=$tag" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" \
      -H "X-Registry-Auth:$registry_auth" \
      -o "$response" \
      -w "%{http_code}" \
      2>"$curl_err" || true)

    if [[ "$http_code" =~ ^(200|201|304)$ ]]; then
      error_msg=$(_sim_cicd_docker_pull_stream_error "$response")
      if [[ -n "$error_msg" ]]; then
        echo "[sim-cicd] Failed to pull image $img: $error_msg" >&2
        rm -f "$response" "$curl_err"
        return 1
      fi
      echo "[sim-cicd] Pulled image $img"
      rm -f "$response" "$curl_err"
      return 0
    fi

    echo "[sim-cicd] Failed to pull image $img (HTTP ${http_code:-000})" >&2
    if [[ -s "$curl_err" ]]; then
      echo "[sim-cicd] curl: $(tr '\n' ' ' <"$curl_err")" >&2
    fi
    error_msg=$(_sim_cicd_docker_pull_stream_error "$response")
    if [[ -z "$error_msg" ]]; then
      error_msg=$(jq -r '.message // .error // empty' "$response" 2>/dev/null || true)
    fi
    [[ -n "$error_msg" ]] && echo "[sim-cicd] Docker error: $error_msg" >&2
    rm -f "$response" "$curl_err"
    return 1
  }

  # Pre-pull every private image referenced by the compose file (once per deploy).
  _sim_cicd_pull_compose_images() {
    local portainer_url="$1"
    local env_id="$2"
    local compose_file="$3"
    local images img

    images=$(_sim_cicd_compose_images "$compose_file")
    [[ -z "$images" ]] && return 0

    echo "[sim-cicd] Pulling compose images before deploy..."
    if ! _sim_cicd_docker_proxy_preflight "$portainer_url" "$env_id"; then
      return 1
    fi
    while IFS= read -r img; do
      [[ -z "$img" ]] && continue
      _sim_cicd_pull_image_via_portainer "$portainer_url" "$env_id" "$img" || return 1
    done <<< "$images"
  }

  # PUT stack file content only (no PullImage — registry auth is handled by pre-pull above).
  _sim_cicd_portainer_stack_update() {
    local portainer_url="$1"
    local env_id="$2"
    local stack_id="$3"
    local compose_file="$4"
    local response http_code error_msg

    response=$(mktemp)
    http_code=$(curl -s -X PUT "https://$portainer_url/api/stacks/${stack_id}?endpointId=$env_id" \
      -H "X-API-Key:$PORTAINER_API_TOKEN" \
      -H "Content-Type: application/json" \
      -o "$response" \
      -w "%{http_code}" \
      -d "$(jq -nc \
        --rawfile content "$compose_file" \
        --arg io_password "$IO_PASSWORD" \
        '{StackFileContent: $content, Env: [{name: "IO_PASSWORD", value: $io_password}]}')")

    if [[ "$http_code" =~ ^2 ]]; then
      echo "[sim-cicd] Stack updated (HTTP $http_code)"
      rm -f "$response"
      return 0
    fi

    echo "[sim-cicd] Stack update failed (HTTP $http_code)" >&2
    error_msg=$(jq -r '.message // .error // empty' "$response" 2>/dev/null || true)
    if [[ -n "$error_msg" ]]; then
      echo "[sim-cicd] Portainer error: $error_msg" >&2
    elif [[ -s "$response" ]]; then
      cat "$response" >&2
    fi
    rm -f "$response"
    return 1
  }

  # Poll container health via Portainer Docker proxy until healthy/unhealthy/timeout.
  _sim_cicd_wait_for_container_health() {
    local portainer_url="$1"
    local env_id="$2"
    local container_id="$3"
    local interval="${4:-3}"
    local max_wait="${5:-300}"

    local elapsed=0
    while [ $elapsed -lt $max_wait ]; do
      local status
      status=$(_sim_cicd_curl_portainer \
          "https://$portainer_url/api/endpoints/$env_id/docker/containers/$container_id/json" \
          -H "X-API-Key:$PORTAINER_API_TOKEN" \
          | jq -r ".State | .Health | .Status" 2>/dev/null)

      if [ "$status" = "healthy" ]; then
        echo "[sim-cicd] Container is healthy after ${elapsed}s!"
        return 0
      elif [ "$status" = "unhealthy" ]; then
        echo "[sim-cicd] Container is unhealthy after ${elapsed}s!" >&2
        return 1
      fi

      echo "[sim-cicd] Waiting for container health check... (current: ${status:-starting} - ${elapsed}s)"
      sleep "$interval"
      elapsed=$((elapsed + interval))
    done

    echo "[sim-cicd] Timeout waiting for container to become healthy (${elapsed}s)" >&2
    return 1
  }

  _sim_cicd_require_tools

}

# :command.initialize
initialize() {
  declare -g version="0.1.0"
  set -e

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "portainer-stack-deploy") simci_portainer_stack_deploy_command ;;
    "portainer-stack-delete") simci_portainer_stack_delete_command ;;
    "portainer-stack-stop") simci_portainer_stack_stop_command ;;
    "portainer-stack-start") simci_portainer_stack_start_command ;;
    "portainer-stack-get-id") simci_portainer_stack_get_id_command ;;
    "portainer-stack-get-file") simci_portainer_stack_get_file_command ;;
    "portainer-stack-get-coverage") simci_portainer_stack_get_coverage_command ;;
    "simplicite-run-unit-tests") simci_simplicite_run_unit_tests_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
