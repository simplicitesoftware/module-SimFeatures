# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        simci_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    portainer-stack-deploy)
      action="portainer-stack-deploy"
      shift
      simci_portainer_stack_deploy_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-delete)
      action="portainer-stack-delete"
      shift
      simci_portainer_stack_delete_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-stop)
      action="portainer-stack-stop"
      shift
      simci_portainer_stack_stop_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-start)
      action="portainer-stack-start"
      shift
      simci_portainer_stack_start_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-get-id)
      action="portainer-stack-get-id"
      shift
      simci_portainer_stack_get_id_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-get-file)
      action="portainer-stack-get-file"
      shift
      simci_portainer_stack_get_file_parse_requirements "$@"
      shift $#
      ;;

    portainer-stack-get-coverage)
      action="portainer-stack-get-coverage"
      shift
      simci_portainer_stack_get_coverage_parse_requirements "$@"
      shift $#
      ;;

    simplicite-run-unit-tests)
      action="simplicite-run-unit-tests"
      shift
      simci_simplicite_run_unit_tests_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      simci_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

